# ============================================================
#  AI 聊天网站 · 服务器端配置示例
#  复制这个文件为 .env（放在 app/ 目录或它的上一级目录），填入你的密钥后重启服务器。
#  .env 已经写进 .gitignore，不会被提交，请放心填写。
#  提示：如果你不想在服务器上放密钥，也可以完全跳过这个文件，
#        直接在网页「设置 → 模型」里填 API Key（密钥只存在浏览器 localStorage）。
# ============================================================

# ---------- 大模型 API Key（填哪家的都行，支持多家并存）----------

# DeepSeek（性价比首选：https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=

# OpenAI
OPENAI_API_KEY=

# 月之暗面 Kimi
MOONSHOT_API_KEY=

# 智谱 GLM
ZHIPU_API_KEY=

# 通义千问（DashScope 兼容模式）
DASHSCOPE_API_KEY=

# 硅基流动（聚合了很多开源模型，注册送额度）
SILICONFLOW_API_KEY=

# OpenRouter（一个 Key 用遍各家模型）
OPENROUTER_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# 自定义 OpenAI Chat Completions 兼容服务（同时在网页中选择「自定义」并填写接口根地址、模型名）
CUSTOM_API_KEY=

# 所有密钥都填厂商提供的原始值，不添加 Bearer；不要求以 sk- 开头，也没有固定长度。

# ---------- 本地模型（无需 Key）----------
# ollama 默认地址 http://127.0.0.1:11434/v1
# LM Studio 默认地址 http://127.0.0.1:1234/v1
# 只要把「设置 → 模型」里的接口地址改成上面两个即可，不需要填 Key。

# ---------- 一个 Key 配多家（可选，格式 provider:key,provider:key）----------
# AICHAT_API_KEYS=deepseek:sk-aaa,openai:sk-bbb

# ---------- 兜底 Key（上面都没匹配到时使用）----------
AICHAT_API_KEY=

# ---------- 访问口令（局域网访问时**必须**设置）----------
# 作用一：别人借用你的代理额度。设置后，浏览器请求 /api/llm、/api/tts 时必须带同一个口令。
# 作用二（更重要）：**保护本机的数据接口**。
#   本服务默认绑定 127.0.0.1，只有本机能访问；一旦用 --host 0.0.0.0 暴露到局域网，
#   所有 /api/db/*（角色、聊天记录、设置里的密钥）以及清空/覆盖接口都要求这个口令。
#   没有设置口令时，来自局域网的接口请求会被直接拒绝（403），
#   也就是说"手机能不能用"取决于这里有没有填口令。
#
# 手机 / 局域网设备怎么用：
#   1) 在这里填一个别人猜不到的口令，例如 AICHAT_PROXY_TOKEN=my-secret-9527
#   2) 用 node server.mjs --host 0.0.0.0 启动
#   3) 手机浏览器打开一次：http://<电脑的局域网IP>:5180/?token=my-secret-9527
#      页面会自动记住口令（HttpOnly Cookie），之后正常使用即可。
# 只在本机（127.0.0.1）使用的话可以留空，本地请求不需要口令。
AICHAT_PROXY_TOKEN=

# ---------- 允许的自定义上游地址（可选，逗号分隔）----------
# "设置 → 模型"里的自定义接口地址会随请求发到服务器，由服务器带着本机的 Key 去请求它。
# 想锁定"只能请求哪些地址"时填这里（填了之后，不在列表内的自定义地址一律拒绝）：
# AICHAT_ALLOWED_UPSTREAMS=http://127.0.0.1:11434/v1,https://my-relay.example.com/v1

# ---------- 服务端口（可选）----------
# PORT=5180
# HOST=127.0.0.1
